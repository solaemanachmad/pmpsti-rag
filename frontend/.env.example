# The frontend always calls the backend through its own /api route:
# - locally, Vite proxies /api to http://localhost:8080 (see vite.config.ts)
# - on Vercel, src/routes/api/[...path]/+server.ts forwards to the Render backend
# No API URL needs to be configured.

# Server-side only (Vercel → Project → Settings → Environment Variables), never PUBLIC_:
# PROXY_SECRET=<same random value as PROXY_SECRET on the Render backend>
#   Lets the backend trust the visitor IP the proxy sends, so login and question limits
#   apply per visitor instead of to everyone at once. Generate with: openssl rand -hex 32
